{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfem.local/schemas/transport_receipt.schema.json",
  "title": "PFEM Transport Receipt",
  "type": "object",
  "required": [
    "transport_receipt_id",
    "receipt_kind",
    "created_time",
    "transport_adapter_id",
    "delivery_channel_id",
    "route_id",
    "source_node_id",
    "destination_node_id",
    "subject_refs",
    "basis_refs",
    "transport_state",
    "outcome_summary"
  ],
  "properties": {
    "transport_receipt_id": {
      "type": "string"
    },
    "receipt_kind": {
      "type": "string"
    },
    "created_time": {
      "type": "string"
    },
    "transport_adapter_id": {
      "type": "string"
    },
    "delivery_channel_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "source_node_id": {
      "type": "string"
    },
    "destination_node_id": {
      "type": "string"
    },
    "subject_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "basis_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transport_state": {
      "type": "string"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome_summary": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
