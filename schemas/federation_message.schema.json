{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfem.local/schemas/federation_message.schema.json",
  "title": "PFEM Federation Message",
  "type": "object",
  "required": [
    "message_id",
    "message_kind",
    "sender_node_id",
    "recipient_node_ids",
    "created_time",
    "lineage_refs",
    "sharing_scope",
    "handling_label",
    "redaction_state",
    "retention_class",
    "disposition_state"
  ],
  "properties": {
    "message_id": {
      "type": "string"
    },
    "message_kind": {
      "type": "string"
    },
    "sender_node_id": {
      "type": "string"
    },
    "recipient_node_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_time": {
      "type": "string"
    },
    "subject_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload_summary": {
      "type": "string"
    },
    "lineage_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sharing_scope": {
      "type": "string"
    },
    "handling_label": {
      "type": "string"
    },
    "redaction_state": {
      "type": "string"
    },
    "retention_class": {
      "type": "string"
    },
    "disposition_state": {
      "type": "string"
    },
    "attribution": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
