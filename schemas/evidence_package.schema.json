{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfem.local/schemas/evidence_package.schema.json",
  "title": "PFEM Evidence Package",
  "type": "object",
  "required": [
    "package_id",
    "created_time",
    "included_refs",
    "scope",
    "summary",
    "retention_class",
    "disposition_state"
  ],
  "properties": {
    "package_id": {
      "type": "string"
    },
    "created_time": {
      "type": "string"
    },
    "included_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "retention_class": {
      "type": "string"
    },
    "disposition_state": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
