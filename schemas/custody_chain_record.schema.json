    "source_closeout_ref",
    "chain_state",
    "start_ref",
    "terminal_ref",
    "final_outcome",
    "final_custodian_ref",
    "final_location_ref",
    "final_location_kind",
    "chain_refs",
    "held_refs",
    "basis_refs",
    "digest_algorithm",
    "chain_ref_digest",
    "summarized_by_ref",
