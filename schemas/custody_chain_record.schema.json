  "properties": {
    "custody_chain_record_id": {
      "type": "string"
    },
    "chain_kind": {
      "type": "string"
    },
    "created_time": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "source_workflow_kind": {
      "type": "string"
    },
    "source_closeout_ref": {
      "type": "string"
    },
    "chain_state": {
      "type": "string"
    },
    "start_ref": {
      "type": "string"
    },
    "terminal_ref": {
      "type": "string"
    },
    "final_outcome": {
      "type": "string"
    },
    "final_custodian_ref": {
      "type": "string"
    },
    "final_location_ref": {
      "type": "string"
    },
    "final_location_kind": {
      "type": "string"
    },
    "chain_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "held_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "basis_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "digest_algorithm": {
      "type": "string"
    },
    "chain_ref_digest": {
      "type": "string"
    },
    "summarized_by_ref": {
      "type": "string"
