{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfem.local/schemas/custody_record.schema.json",
  "title": "PFEM Custody Record",
  "type": "object",
  "required": [
    "custody_record_id",
    "custody_kind",
    "created_time",
    "node_id",
    "disposition_receipt_id",
    "disposition_record_id",
    "source_workflow_kind",
    "source_closeout_ref",
    "custody_state",
    "custodian_ref",
    "custody_location_ref",
    "custody_location_kind",
    "custody_scope",
    "held_refs",
    "basis_refs",
    "recorded_by_ref",
    "summary"
  ],
  "properties": {
    "custody_record_id": {
      "type": "string"
    },
    "custody_kind": {
      "type": "string"
    },
    "created_time": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "disposition_receipt_id": {
      "type": "string"
    },
    "disposition_record_id": {
      "type": "string"
    },
    "source_workflow_kind": {
      "type": "string"
    },
    "source_closeout_ref": {
      "type": "string"
    },
    "custody_state": {
      "type": "string"
    },
    "custodian_ref": {
      "type": "string"
    },
    "custody_location_ref": {
      "type": "string"
    },
    "custody_location_kind": {
      "type": "string"
    },
    "custody_scope": {
      "type": "string"
    },
    "held_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "basis_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recorded_by_ref": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
