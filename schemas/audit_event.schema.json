{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfem.local/schemas/audit_event.schema.json",
  "title": "PFEM Audit Event",
  "type": "object",
  "required": [
    "audit_id",
    "event_kind",
    "created_time",
    "actor_ref",
    "subject_refs",
    "summary"
  ],
  "properties": {
    "audit_id": {
      "type": "string"
    },
    "event_kind": {
      "type": "string"
    },
    "created_time": {
      "type": "string"
    },
    "actor_ref": {
      "type": "string"
    },
    "subject_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "source_tool": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
