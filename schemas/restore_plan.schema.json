{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfem.local/schemas/restore_plan.schema.json",
  "title": "PFEM Restore Plan",
  "type": "object",
  "required": [
    "restore_plan_id",
    "plan_kind",
    "created_time",
    "node_id",
    "recovery_point_id",
    "restore_scope",
    "plan_state",
    "planned_restore_refs",
    "preconditions",
    "basis_refs",
    "planned_by_ref",
    "summary"
  ],
  "properties": {
    "restore_plan_id": {
      "type": "string"
    },
    "plan_kind": {
      "type": "string"
    },
    "created_time": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "recovery_point_id": {
      "type": "string"
    },
    "state_checkpoint_id": {
      "type": "string"
    },
    "snapshot_manifest_id": {
      "type": "string"
    },
    "snapshot_verification_receipt_id": {
      "type": "string"
    },
    "restore_scope": {
      "type": "string"
    },
    "plan_state": {
      "type": "string"
    },
    "planned_restore_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "basis_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "planned_by_ref": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
