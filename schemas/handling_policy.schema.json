{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfem.local/schemas/handling_policy.schema.json",
  "title": "PFEM Handling Policy",
  "type": "object",
  "required": [
    "policy_id",
    "version",
    "handling_labels"
  ],
  "properties": {
    "policy_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "handling_labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label_id",
          "display_name",
          "description",
          "allowed_sharing_scopes",
          "requires_redaction_before_share",
          "allowed_redaction_states"
        ],
        "properties": {
          "label_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "allowed_sharing_scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_redaction_before_share": {
            "type": "boolean"
          },
          "allowed_redaction_states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
