{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfem.local/schemas/source_registry.schema.json",
  "title": "PFEM Source Registry",
  "type": "object",
  "required": [
    "registry_id",
    "version",
    "sources"
  ],
  "properties": {
    "registry_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "display_name",
          "source_kind",
          "adapter_id",
          "node_id",
          "status"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "source_kind": {
            "type": "string"
          },
          "adapter_id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
