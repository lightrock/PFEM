{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfem.local/schemas/delivery_job.schema.json",
  "title": "PFEM Delivery Job",
  "type": "object",
  "required": [
    "delivery_job_id",
    "job_kind",
    "created_time",
    "route_id",
    "delivery_channel_id",
    "transport_adapter_id",
    "source_node_id",
    "destination_node_id",
    "subject_refs",
    "basis_refs",
    "job_state",
    "priority",
    "summary"
  ],
  "properties": {
    "delivery_job_id": {
      "type": "string"
    },
    "job_kind": {
      "type": "string"
    },
    "created_time": {
      "type": "string"
    },
    "requested_by_ref": {
      "type": "string"
    },
    "dispatch_rule_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "delivery_channel_id": {
      "type": "string"
    },
    "transport_adapter_id": {
      "type": "string"
    },
    "source_node_id": {
      "type": "string"
    },
    "destination_node_id": {
      "type": "string"
    },
    "subject_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "basis_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "job_state": {
      "type": "string"
    },
    "priority": {
      "type": "string"
    },
    "not_before_time": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
