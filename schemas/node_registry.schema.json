{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfem.local/schemas/node_registry.schema.json",
  "title": "PFEM Node Registry",
  "type": "object",
  "required": [
    "registry_id",
    "version",
    "nodes"
  ],
  "properties": {
    "registry_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "path",
          "profile_id",
          "status"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "profile_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
