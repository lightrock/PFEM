{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfem.local/schemas/rollup_summary.schema.json",
  "title": "PFEM Rollup Summary",
  "type": "object",
  "required": [
    "rollup_id",
    "producer_node_id",
    "created_time",
    "summary_kind",
    "source_lineage_refs",
    "sharing_scope",
    "handling_label",
    "redaction_state",
    "retention_class",
    "disposition_state"
  ],
  "properties": {
    "rollup_id": {
      "type": "string"
    },
    "producer_node_id": {
      "type": "string"
    },
    "created_time": {
      "type": "string"
    },
    "summary_kind": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "included_subject_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_lineage_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence_notes": {
      "type": "string"
    },
    "completeness_notes": {
      "type": "string"
    },
    "sharing_scope": {
      "type": "string"
    },
    "handling_label": {
      "type": "string"
    },
    "redaction_state": {
      "type": "string"
    },
    "retention_class": {
      "type": "string"
    },
    "disposition_state": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
