{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfem.local/schemas/archive_manifest_record.schema.json",
  "title": "PFEM Archive Manifest Records",
  "type": "object",
  "required": [
    "archive_manifest_record_id",
    "manifest_kind",
    "created_time",
    "node_id",
    "custody_lifecycle_closeout_record_id",
