    "manifest_kind": {
      "type": "string"
    },
    "created_time": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "custody_lifecycle_closeout_record_id": {
      "type": "string"
    },
    "manifest_state": {
      "type": "string"
    },
    "archive_scope": {
      "type": "string"
    },
    "manifested_refs": {
      "type": "array"
    },
    "subject_refs": {
      "type": "array"
    },
    "basis_refs": {
      "type": "array"
    },
    "digest_algorithm": {
      "type": "string"
    },
    "manifest_ref_digest": {
      "type": "string"
    },
    "manifested_by_ref": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
