{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfem.local/schemas/dispatch_decision.schema.json",
  "title": "PFEM Dispatch Decision",
  "type": "object",
  "required": [
    "dispatch_decision_id",
    "decision_kind",
    "created_time",
    "delivery_job_id",
    "dispatch_rule_id",
    "decision",
    "reason_code",
    "decided_by_ref",
    "basis_refs",
    "summary"
  ],
  "properties": {
    "dispatch_decision_id": {
      "type": "string"
    },
    "decision_kind": {
      "type": "string"
    },
    "created_time": {
      "type": "string"
    },
    "delivery_job_id": {
      "type": "string"
    },
    "dispatch_rule_id": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "reason_code": {
      "type": "string"
    },
    "decided_by_ref": {
      "type": "string"
    },
    "basis_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resulting_job_state": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
