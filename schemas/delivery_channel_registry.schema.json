{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfem.local/schemas/delivery_channel_registry.schema.json",
  "title": "PFEM Delivery Channel Registry",
  "type": "object",
  "required": [
    "registry_id",
    "version",
    "channels"
  ],
  "properties": {
    "registry_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "channel_id",
          "channel_kind",
          "status",
          "supports_route_kinds",
          "summary"
        ],
        "properties": {
          "channel_id": {
            "type": "string"
          },
          "channel_kind": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "supports_route_kinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "destination_node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_sharing_scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_handling_labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
